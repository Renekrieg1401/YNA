# Pflege-Fakten Server — Umgebungsvariablen (Vorlage, .env selbst NIE committen)

# Interner Port, hinter nginx-Reverse-Proxy (TLS macht devops-infra, nicht dieser Server)
PORT=4100

# Admin-PIN NIEMALS im Klartext hier eintragen. Hash erzeugen via:
#   node scripts/hash-pin.js <gewuenschte-pin>
# und NUR den Hash hier einfuegen.
ADMIN_PIN_HASH=

# Zufaelliger, langer String fuer JWT-Signierung (z.B. `openssl rand -hex 32`)
JWT_SECRET=

# Gmail-SMTP fuer Draft-Benachrichtigungen (nodemailer). SMTP_APP_PASSWORD ist ein
# Google-App-Passwort (NICHT das normale Gmail-Passwort) -- muss René selbst in den
# Google-Kontoeinstellungen erzeugen (https://myaccount.google.com/apppasswords).
# Ohne diese beiden Werte funktioniert der Mailversand nicht -- Crawl-Lauf bricht
# dadurch NICHT ab, der Fehler wird nur geloggt (s. mailer.js).
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_TO=pflegefaktencheck@gmail.com

# Pfad zur SQLite-Datei (relativ zu server/, Default reicht meist)
DB_PATH=./pflege-fakten.db

# Basis-URL des Admin-Panels fuer Links in Benachrichtigungs-Mails (ohne trailing slash)
ADMIN_PANEL_URL=https://pflege-fakten.example/admin
